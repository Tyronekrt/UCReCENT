# Copy to .env (NEVER commit .env — it holds secrets)
# ------------------------------------------------------------------
# Core
SECRET_KEY=generate-a-long-random-value-for-production
DEBUG=False
ALLOWED_HOSTS=api.usaolibrary.example.org
FRONTEND_URL=https://usaolibrary.example.org

# PostgreSQL (production database)
POSTGRES_DB=usao_library
POSTGRES_USER=usao
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS / CSRF — frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://usaolibrary.example.org
CSRF_TRUSTED_ORIGINS=https://api.usaolibrary.example.org

# Email provider (SMTP). Local dev default is the console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.org
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@usaolibrary.example.org
# Inbox for support-request / contact-message notifications
NOTIFICATION_EMAIL=olooo.odhiambo@gmail.com
NOTIFICATION_EXTRA_EMAILS=

# Production hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
