# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://usaolibrary.example.org
# Django API base URL (empty = render verified static fallback content).
# Local backend: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Managed via API when set: updates, gallery, partners, impact stats.
# Core facts (budget, dates, vision/mission) always stay static in lib/site.ts.
NEXT_PUBLIC_API_URL=
# Contact inbox used only as a display fallback; real submissions go to the API
NEXT_PUBLIC_CONTACT_EMAIL=olooo.odhiambo@gmail.com
